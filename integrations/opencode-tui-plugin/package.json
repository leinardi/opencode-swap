{
  "name": "@leinardi/opencode-swap",
  "version": "0.3.0",
  "description": "OpenCode TUI account switcher for opencode-swap",
  "type": "module",
  "license": "MIT",
  "author": "Roberto Leinardi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leinardi/opencode-swap.git",
    "directory": "integrations/opencode-tui-plugin"
  },
  "bugs": {
    "url": "https://github.com/leinardi/opencode-swap/issues"
  },
  "homepage": "https://github.com/leinardi/opencode-swap#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "account-switcher"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix --max-warnings 0",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "bun run typecheck && bun run lint && bun run pack:check",
    "prepublishOnly": "bun run check"
  },
  "files": [
    "src/tui.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "engines": {
    "node": ">=20",
    "opencode": "1.18.x"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.18.x",
    "@opentui/solid": "0.4.x",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.5",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "eslint": "9.28.0",
    "eslint-plugin-solid": "0.14.5",
    "jiti": "2.7.0",
    "solid-js": "1.9.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
