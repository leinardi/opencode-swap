{
  "name": "@leinardi/opencode-swap",
  "version": "0.4.6",
  "description": "OpenCode 2 TUI plugin: active account and usage in the prompt footer, and one-step account switching",
  "type": "module",
  "license": "MIT",
  "author": "Roberto Leinardi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leinardi/opencode-swap.git"
  },
  "bugs": {
    "url": "https://github.com/leinardi/opencode-swap/issues"
  },
  "homepage": "https://github.com/leinardi/opencode-swap#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "account-switcher"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "lint": "eslint src test --max-warnings 0",
    "lint:fix": "eslint src test --fix --max-warnings 0",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run pack:check",
    "prepublishOnly": "bun run build && bun run check"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "engines": {
    "opencode": ">=2.0.20 <3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opentui/core": "0.5.x",
    "@opentui/solid": "0.5.x",
    "solid-js": "1.9.x"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.20",
    "@opencode/theme": "2.0.20",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.2",
    "eslint": "10.12.0",
    "eslint-plugin-solid": "0.18.1",
    "jiti": "2.7.0",
    "solid-js": "1.9.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
