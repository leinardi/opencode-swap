# Build output and dependencies (bun.lock is committed).
node_modules/
dist/
*.tgz

# Logs and local environment files
*.log
.env
.envrc

# Left behind by checkouts of the Python CLI (v0.5.0 and older): ignored so that switching
# branches does not show them as untracked.
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Password-encrypted opencode-swap account exports, written by the 0.4.x CLI.
*.ocs

#IDEs
# IntelliJ IDEA / JetBrains
.idea/*
!.idea/codeStyles/
!.idea/copyright/
*.iml
out/
.gradle/

# Other editors
.vscode/
*.code-workspace
*.swp
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Tool caches
.cache/

# Claude Code: the shared settings and the skills symlink are tracked; local settings
# (settings.local.json) and session state never are.
.claude/*
!.claude/settings.json
!.claude/skills
